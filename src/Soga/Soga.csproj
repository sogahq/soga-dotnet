<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Soga</PackageId>
    <Version>0.2.0-preview.1</Version>
    <Authors>Zhuwa Africa Limited</Authors>
    <Description>Embeddable direct messaging primitives and ASP.NET Core integration.</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>soga-package-icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\assets\soga-package-icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Soga.EntityFrameworkCore" />
    <InternalsVisibleTo Include="Soga.Tests" />
    <InternalsVisibleTo Include="Soga.IntegrationTests" />
    <InternalsVisibleTo Include="Soga.EntityFrameworkCore.Tests" />
  </ItemGroup>

</Project>
